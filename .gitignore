# Environment variables
.env
.env.local
.env.development
.env.production
.env.test
.env.*.local
secrets/*
!secrets/.gitkeep

# Locally-generated TLS certificates (machine-specific, never shared)
certs/*.pem

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
