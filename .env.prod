COMPOSE_PROJECT_NAME=recordly

# App Specific
DB_HOST=postgres_db
DB_PORT=5432
DB_NAME=recordly
DB_USER=recordly_db
DB_PASSWORD=recordly123
NODE_ENV=production
PORT=5001

# Docker Specific
POSTGRESQL_PORT=5432
POSTGRESQL_USERNAME=recordly_db
POSTGRESQL_DATABASE=recordly
POSTGRESQL_PASSWORD=recordly123

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123

# Frontend
VITE_API_URL=http://localhost:5001/api
VITE_ASSET_URL=http://localhost:5001
CORS_ORIGINS=https://your-frontend-domain.example

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO AIStor Free
# Pin this to a tested AIStor release before deployment.
MINIO_IMAGE=quay.io/minio/aistor/minio:latest
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=replace_me
MINIO_ROOT_PASSWORD=replace_me_with_a_strong_password
S3_REGION=us-east-1
S3_BACKEND_ACCESS_KEY=replace_me_backend
S3_BACKEND_SECRET_KEY=replace_me_with_a_strong_backend_secret
S3_OCR_ACCESS_KEY=replace_me_ocr
S3_OCR_SECRET_KEY=replace_me_with_a_strong_ocr_secret

# Tesseract OCR
OCR_QUEUE_NAME=ocr-queue

# Security
ENCRYPTION_KEY=secret_key
JWT_SECRET=replace_me_with_a_strong_secret
# The admin account is created once, at first start; changing these later does not change it.
DEFAULT_ADMIN_EMAIL=replace_me_admin@example.com
DEFAULT_ADMIN_PASSWORD=replace_me_with_a_strong_admin_password
SEED_USER_NAME=seed_admin
SEED_USER_PASSWORD=replace_me_with_a_strong_seed_password
