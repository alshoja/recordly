COMPOSE_PROJECT_NAME=recordly

# App Specific
DB_HOST=postgres_db
DB_PORT=5432
DB_NAME=recordly
DB_USER=recordly_db
DB_PASSWORD=recordly123
NODE_ENV=development
PORT=5001

# Docker Specific
POSTGRESQL_PORT=5432
POSTGRESQL_USERNAME=recordly_db
POSTGRESQL_DATABASE=recordly
POSTGRESQL_PASSWORD=recordly123

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123

# Local Domain / TLS
# ./setup.sh generates a trusted certificate for these domains (via mkcert) and
# adds them to /etc/hosts, so the app is reachable at https://recordly.techdev instead
# of http://localhost:3000. See docs/DEVELOPMENT.md for details.
APP_DOMAIN=recordly.techdev
API_DOMAIN=api.recordly.techdev
PGADMIN_DOMAIN=pgadmin.recordly.techdev

# Frontend
VITE_API_URL=https://api.recordly.techdev/api
VITE_ASSET_URL=https://api.recordly.techdev
CORS_ORIGINS=https://recordly.techdev

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# AI Chat / LLM provider
# AI_PROVIDER selects which adapter backs chat + embeddings: "ollama" (local) or "openai" (production).
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
# get your own key from https://platform.openai.com/account/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_CHAT_ENABLED=true

DOCUMENT_SEARCH_HYBRID_ENABLED=true
ELASTICSEARCH_NODE=http://elasticsearch:9200
ELASTICSEARCH_INDEX=document_chunks
DOCUMENT_SEARCH_VECTOR_WEIGHT=0.6
DOCUMENT_SEARCH_BM25_WEIGHT=0.4
DOCUMENT_SEARCH_BM25_RESULT_LIMIT=20

# MinIO AIStor Free
MINIO_IMAGE=quay.io/minio/aistor/minio:latest
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=replace_me
MINIO_ROOT_PASSWORD=replace_me_with_a_strong_password
S3_REGION=us-east-1
S3_BACKEND_ACCESS_KEY=replace_me_backend
S3_BACKEND_SECRET_KEY=replace_me_with_a_strong_backend_secret
S3_OCR_ACCESS_KEY=replace_me_ocr
S3_OCR_SECRET_KEY=replace_me_with_a_strong_ocr_secret

# Tesseract OCR
OCR_WORKER_CONCURRENCY=2
OCR_PORT=6000
OCR_QUEUE_NAME=ocr-queue


# Encryption
ENCRYPTION_KEY=secret_key
JWT_SECRET=akahdkj
SEED_USER_NAME=seed_admin
SEED_USER_PASSWORD=SeedPass123!

# Default admin: required in production. When unset (development) the app falls
# back to admin@gmail.com / test@12345. Created once at first start; changing
# these later does not change an existing admin.
# DEFAULT_ADMIN_EMAIL=admin@example.com
# DEFAULT_ADMIN_PASSWORD=replace_me_with_a_strong_admin_password
